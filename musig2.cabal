cabal-version:   3.0
name:            musig2
version:         0.1.0
synopsis:        MuSig2 library
license:         MIT
license-file:    LICENSE
author:          Jose Storopoli
maintainer:      jose@storopoli.com
category:        Cryptography
build-type:      Simple
tested-with:     GHC ==9.8.4
extra-doc-files: CHANGELOG
description:     MuSig2 signing Haskell library. TODO: add description.

source-repository head
  type:     git
  location: github.com/storopoli/musig2.git

library
  default-language: Haskell2010
  hs-source-dirs:   lib
  ghc-options:      -Wall
  exposed-modules:  Crypto.Curve.Secp256k1.MuSig2
  build-depends:
    , base               >=4.9 && <5
    , base16-bytestring  >=1.0 && <1.1.0
    , bytestring         >=0.9 && <0.13
    , ppad-secp256k1     >=0.3 && <0.5
    , ppad-sha256        >=0.2 && <0.3.0

test-suite musig2-tests
  type:             exitcode-stdio-1.0
  default-language: Haskell2010
  hs-source-dirs:   test
  main-is:          Main.hs
  other-modules:
    AggPubkeys
    MonoidProjective
    SortPubkeys
    Util

  ghc-options:      -rtsopts -Wall
  build-depends:
    , base
    , base16-bytestring
    , bytestring
    , musig2
    , ppad-secp256k1
    , tasty
    , tasty-hunit
    , tasty-quickcheck

benchmark musig2-bench
  type:             exitcode-stdio-1.0
  default-language: Haskell2010
  hs-source-dirs:   bench
  main-is:          Main.hs
  ghc-options:      -rtsopts -O2 -Wall -fno-warn-orphans
  build-depends:
    , base
    , bytestring
    , criterion
    , deepseq
    , musig2
